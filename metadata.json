{
  "name": "simp-nm",
  "version": "0.4.0",
  "author": "SIMP Team",
  "summary": "manages the infamous NetworkManager",
  "license": "Apache-2.0",
  "source": "https://github.com/simp/pupmod-simp-nm",
  "project_page": "https://github.com/simp/pupmod-simp-nm",
